{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade email scheduler service with BullMQ delayed jobs",
  "main": "dist/server.js",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/queue/scripts', {recursive:true}); fs.copyFileSync('src/queue/scripts/reserveSlot.lua', 'dist/queue/scripts/reserveSlot.lua');\"",
    "start": "node dist/app.js",
    "start:all": "node dist/app.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^5.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "bullmq": "^5.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.10.5"
  }
}
